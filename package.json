{
  "name": "code-djvu",
  "displayName": "code-djvu",
  "description": "code djvu viewer",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:djvuViewer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "djvuViewer",
        "displayName": "DjVu Viewer",
        "selector": [
          {
            "filenamePattern": "*.djvu"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "djvuViewer.openViewer",
        "title": "Open in DjVu Viewer"
      },
      {
        "command": "djvuViewer.zoomIn",
        "title": "DjVu: Zoom In"
      },
      {
        "command": "djvuViewer.zoomOut",
        "title": "DjVu: Zoom Out"
      },
      {
        "command": "djvuViewer.rotateClockwise",
        "title": "DjVu: Rotate Clockwise"
      },
      {
        "command": "djvuViewer.search",
        "title": "DjVu: Search in Document"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.3",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.0.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "code-djvu": "file:"
  },
  "overrides": {
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.2"
  }
}
